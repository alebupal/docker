# =============================================================================
# 1. Regla general para subcarpetas: ignorar TODO salvo config.sh y docker-compose.yml
# =============================================================================
*/*
!*/config.sh
!*/docker-compose.yml

# =============================================================================
# 2. Excepción: suite-web (configuración nginx/php y código web limpio)
# =============================================================================
!suite-web/README.md
!suite-web/nginx/
!suite-web/nginx/**
!suite-web/php/
!suite-web/php/**
!suite-web/www/
!suite-web/www/**

# Excluir archivos pesados, cachés, descargas y generador privado dentro de suite-web/www/
suite-web/www/generarPassword/
suite-web/www/generarPoster.zip
suite-web/www/generarPoster/cache/
suite-web/www/generarPoster/.tmdb_api_key
suite-web/www/generarPoster/cover_download/
suite-web/www/generarPoster/cover/*.psd
suite-web/www/generarPoster/cover/*.pdf
suite-web/www/descargas/descargas/
suite-web/www/descargas/tree.json
suite-web/www/descargas/tree-data.js
suite-web/www/descargas/.tree.lock
suite-web/www/descargas/*.tmp

# =============================================================================
# 3. Archivos ocultos y temporales en la raíz
# =============================================================================
.env
.user_home
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/

# =============================================================================
# 4. Excepción: CI de GitHub Actions
# =============================================================================
!.github/workflows/
!.github/workflows/*.yml
